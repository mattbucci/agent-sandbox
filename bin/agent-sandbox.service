# Installed by `sudo bin/sandbox-ctl install-service`, which substitutes the
# checkout path for @SANDBOX_ROOT@.
[Unit]
Description=Agent Sandbox - Firecracker VM Manager
After=network-online.target squid.service dnsmasq.service
Wants=network-online.target squid.service dnsmasq.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@SANDBOX_ROOT@/bin/agent-sandbox-boot.sh
# Stop the VMs but keep their state, so the next boot restores them.
ExecStop=@SANDBOX_ROOT@/bin/sandbox-ctl stop-all --keep-state
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target

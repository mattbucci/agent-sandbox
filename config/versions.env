# --- Host: shared agent memory (sandbox-ctl mnemosyne install) ---------------
# 4.0.0 is a major release with an on-disk format change; moving to it is a
# deliberate migration of state/mnemosyne/data, not a routine bump.
MNEMOSYNE_VERSION="3.10.1"

# --- Real hermes-agent backend ------------------------------------------------
# Upstream moved from date tags to semver (v0.23.x). Upgrading means re-baking
# the image and re-validating the runs/approval contract, so it stays on the
# validated tag until that is done deliberately.
HERMES_AGENT_VERSION="v2026.6.19"

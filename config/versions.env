# =============================================================================
# config/versions.env — the single source of truth for every third-party
# version this project downloads, with the SHA-256 of each artifact.
#
# Plain KEY="value" lines: sourced by the host scripts (lib/versions.sh) and
# prepended to every compiled build/<agent>/customize.sh, so install scripts
# running inside the rootfs chroot see the same pins.
#
# Policy: pin the newest upstream release that is at least 14 days old, and
# verify the checksum before anything is installed. Nothing is fetched from a
# moving ref (no `main` install scripts, no "latest").
#
# Updating a pin: change the version, then run
#     bin/sandbox-ctl versions verify      # re-downloads + checks every sha256
#     bin/sandbox-ctl versions outdated    # pinned vs newest upstream
# Checksums are for x86_64; on other architectures fetch_verified refuses to
# install unless ALLOW_UNVERIFIED=1.
# =============================================================================

# --- Host: hypervisor --------------------------------------------------------
FIRECRACKER_VERSION="v1.17.0"
FIRECRACKER_SHA256="06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558"

# Guest kernel. Firecracker stopped publishing CI kernels after the v1.15
# series; 6.1 remains a validated guest kernel for v1.17.
GUEST_KERNEL_CI_SERIES="v1.15"
GUEST_KERNEL_VERSION="6.1.155"
GUEST_KERNEL_SHA256="e20e46d0c36c55c0d1014eb20576171b3f3d922260d9f792017aeff53af3d4f2"


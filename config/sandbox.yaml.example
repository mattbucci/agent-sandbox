llm:
  # LAN LLM router (OpenAI-compatible). No auth required; placeholder key.
  # Aliases: gemma (default, multimodal), north (reasoning/code), smart, council.
  api_base: "http://simple-llm-router.ph.ca:8080/v1"
  api_key: "sk-lan"
  model: "gemma"

vm_defaults:
  vcpus: 4
  mem_mb: 8192

network:
  host_iface: "enp12s0"
  subnet_prefix: "10.0"
  novnc_base_port: 6080
  ssh_base_port: 2200

firecracker:
  bin: "/usr/local/bin/firecracker"
  jailer: "/usr/local/bin/jailer"

rootfs:
  size_mb: 8192

squid:
  http_port: 3128
  https_port: 3129

# Hermes Gateway router — exposes sandboxed agents to hermes-webui over an
# OpenAI-compatible API. Compiled to state/gateway/gateway.json by compile-gateway.
gateway:
  enabled: true
  bind: "0.0.0.0"          # host LAN bind for the router
  port: 8642
  default_agent: "feature-dev"
  vm_gateway_port: 8642    # in-VM OpenAI server port (inside each VM)

  # Scheduling, async tasks, observability and the ops dashboard. Every key
  # below is OPTIONAL: defaults live only in the Go router (applyDefaults()),
  # and compile-gateway copies these blocks into gateway.json verbatim when
  # present — omit a block entirely and the router behaves the same.
  scheduler:
    default_concurrency: 1          # per-agent simultaneous runs, sync+async combined
    sync_queue_max: 4               # waiting sync requests per agent before 429
    sync_queue_wait_s: 120          # max sync queue wait before 503
    async_starvation_after_s: 300   # aging: async slot request jumps sync FIFO after this
    retry_after_s: 15               # Retry-After on 429/503
  tasks:
    enabled: true
    dir: ""                         # "" -> <state_dir>/gateway/tasks
    default_timeout_s: 3600         # per attempt
    default_deadline_s: 86400
    default_max_attempts: 2
    retry_on_partial: false
    retry_backoff_base_s: 10        # backoff(n)=min(base*2^(n-1), cap)
    retry_backoff_cap_s: 600
    idle_timeout_s: 900             # no SSE bytes this long -> attempt fails
    vm_unavailable_retry_s: 30
    retention_h: 168
    max_records: 2000
    max_pending_per_agent: 200
  observability:
    otlp_endpoint: "http://127.0.0.1:4318"   # "" disables span export (traceparent still propagated)
    sample_ratio: 1.0
    log_format: "json"              # json|text
    traces_file: "/var/log/otel/traces.jsonl"
    squid_access_log: "/var/log/squid/access.log"
  dashboard:
    enabled: true
    # Dedicated ops bearers for /dashboard/api/* (generate with:
    # echo "hgwd_$(openssl rand -hex 24)"). Empty list => APIs 403 fail-closed.
    tokens: ["hgwd_your-dashboard-token-here"]

  tokens:
    # North-gate bearer the router requires from incoming webui requests.
    - name: "hermes-webui"
      token: "hgw_your-gateway-token-here"
      agents: ["*"]
  agents:                  # exposed agent types + downstream per-VM key (may be "")
    # Optional per-agent `concurrency` overrides scheduler.default_concurrency
    # (0/absent = default).
    feature-dev: { api_server_key: "", concurrency: 1 }
    debugger:    { api_server_key: "" }
    devops:      { api_server_key: "" }
    researcher:  { api_server_key: "" }
    security:    { api_server_key: "" }
    # Coding specialist pinned to a code model. config/agents/coder.yaml sets
    # `vm.model: north`, so this agent's LLM_MODEL is the North-Mini-Code model
    # on the LAN router while every other agent stays on the global llm.model.
    # Route coding tasks here (e.g. `ygg hermes back <ref> --agent coder`).
    coder:       { api_server_key: "" }
    # Real NousResearch/hermes-agent v2026.6.19 (Docker, pre-baked into the VM).
    # Its in-VM API server requires this bearer; the router presents it downstream.
    # `model` rewrites the outgoing OpenAI model field (the agent id "hermes") to a
    # real LLM alias before forwarding, so the container's API server accepts it.
    hermes:      { api_server_key: "hgw_your-gateway-token-here", model: "gemma" }

# Mnemosyne shared agent-memory service (MCP over SSE). Runs on the sandbox
# HOST (bin/sandbox-ctl mnemosyne ...), bound 0.0.0.0:<port>; agent VMs reach it
# at http://mnemosyne.host:<port>/sse (mnemosyne.host -> the VM's gateway IP).
memory:
  enabled: true
  port: 8077
  token: "mnem_your-token"
  # Embedding backend: "fastembed" (local), "none" (FTS5 keyword-only),
  # or a remote OpenAI-compatible /v1 URL.
  embeddings: "fastembed"

{
  "boot-source": {
    "kernel_image_path": "__KERNEL_PATH__",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off ipv6.disable=1 init=/sbin/agent-init VM_IP=__VM_IP__ GATEWAY_IP=__GATEWAY_IP__ DNS_IP=__DNS_IP__ HOSTNAME=__HOSTNAME__ NO_AGENT=__NO_AGENT__"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "__ROOTFS_PATH__",
      "is_root_device": true,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": __VCPUS__,
    "mem_size_mib": __MEM_MB__
  },
  "network-interfaces": [
    {
      "iface_id": "eth0",
      "guest_mac": "__GUEST_MAC__",
      "host_dev_name": "__TAP_NAME__",
      "rx_rate_limiter": {
        "bandwidth": { "size": 104857600, "refill_time": 1000 }
      },
      "tx_rate_limiter": {
        "bandwidth": { "size": 104857600, "refill_time": 1000 }
      }
    }
  ],
  "logger": {
    "log_path": "__LOG_PATH__",
    "level": "Info",
    "show_level": true,
    "show_log_origin": true
  },
  "metrics": {
    "metrics_path": "__METRICS_PATH__"
  }
}
